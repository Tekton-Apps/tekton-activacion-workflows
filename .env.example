# Panel de Triggers — variables de entorno (Tekton)
# Copiar a .env.local para desarrollo, y cargar en Vercel (Production) para el deploy.
# NUNCA commitear valores reales: .env.local y demás .env* están gitignoreados;
# solo este .env.example (sin valores) se versiona.

# --- n8n (webhooks de la instancia de Tekton; URLs reales solo en Vercel / .env.local) ---
# Un par URL + SECRET por webhook. El SECRET es el valor del header X-Webhook-Secret que exige
# el nodo Webhook (Header Auth). Server-side only: nunca se expone al cliente ni se loguea.
# Mientras falte cualquiera de los dos, la card / formulario / historial correspondiente se
# muestra como "No configurado" en vez de fallar.

# Pestaña Contabilidad — Workflow INC (P&L de Tekton INC).
N8N_TEKTON_INC_WEBHOOK_URL=
N8N_TEKTON_INC_WEBHOOK_SECRET=

# Pestaña Contabilidad — Workflow SAC (P&L de Tekton SAC).
N8N_TEKTON_SAC_WEBHOOK_URL=
N8N_TEKTON_SAC_WEBHOOK_SECRET=

# Pestaña RH — maestro de trabajadores (GET).
N8N_TEKTON_RH_WORKERS_URL=
N8N_TEKTON_RH_WORKERS_SECRET=

# Pestaña RH — generar liquidación (POST).
N8N_TEKTON_RH_LIQ_URL=
N8N_TEKTON_RH_LIQ_SECRET=

# Historial de ejecuciones de ambas pestañas (GET ?area=rh|contabilidad&limit=30).
N8N_TEKTON_EJECUCIONES_URL=
N8N_TEKTON_EJECUCIONES_SECRET=

# --- Whitelists de acceso, una por pestaña (ver lib/tabs.ts) ---
# Emails autorizados separados por comas. El login exige estar en al menos una; cada pestaña
# se muestra solo a su whitelist y cada API route la revalida en cada request.
# Pestaña Contabilidad. Ejemplo: alguien@dominio.com,otro@dominio.com
TEKTON_ALLOWED_EMAILS=
# Pestaña RH.
TEKTON_RH_ALLOWED_EMAILS=

# --- Auth.js v5 (Google OAuth, sin base de datos) ---
# Secret de sesión. Generar con: npx auth secret
AUTH_SECRET=
# Credenciales del OAuth 2.0 Client ID (Web application) de Google Cloud Console (proyecto
# de Tekton).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Opcional: normalmente autodetectada en Vercel. Setear solo si el callback de OAuth
# falla por URL incorrecta (ej. AUTH_URL=https://tu-dominio.vercel.app).
# AUTH_URL=
