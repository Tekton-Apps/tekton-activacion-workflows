# Panel de Triggers — variables de entorno (Tekton)
# Copiar a .env.local para desarrollo, y cargar en Vercel (Production) para el deploy.
# NUNCA commitear valores reales: .env.local y demás .env* están gitignoreados;
# solo este .env.example (sin valores) se versiona.

# --- n8n (tektonlabs.app.n8n.cloud) ---
# Un par URL + SECRET por workflow. Mientras no estén seteadas, la card correspondiente se
# muestra deshabilitada ("No configurado todavía en n8n") en vez de un botón.

# Workflow INC (P&L de Tekton INC).
N8N_TEKTON_INC_WEBHOOK_URL=
# Valor del header X-Webhook-Secret que exige el nodo Webhook en n8n. Server-side only:
# nunca se expone al cliente ni se loguea.
N8N_TEKTON_INC_WEBHOOK_SECRET=

# Workflow SAC (P&L de Tekton SAC).
N8N_TEKTON_SAC_WEBHOOK_URL=
N8N_TEKTON_SAC_WEBHOOK_SECRET=

# --- Whitelist de acceso ---
# Lista de emails autorizados, separados por comas. Chequeada en el login (Auth.js) y
# de nuevo en cada request a /api/trigger. Ejemplo: alguien@dominio.com,otro@dominio.com
TEKTON_ALLOWED_EMAILS=

# --- Auth.js v5 (Google OAuth, sin base de datos) ---
# Secret de sesión. Generar con: npx auth secret
AUTH_SECRET=
# Credenciales del OAuth 2.0 Client ID (Web application) de Google Cloud Console (proyecto
# de Tekton).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Opcional: normalmente autodetectada en Vercel. Setear solo si el callback de OAuth
# falla por URL incorrecta (ej. AUTH_URL=https://tu-dominio.vercel.app).
# AUTH_URL=
