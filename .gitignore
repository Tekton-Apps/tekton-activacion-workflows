# Shared skills library — not part of this app, kept local per project decision
.agents/skills/

# Secrets — never commit env vars (N8N_PLL_WEBHOOK_SECRET, AUTH_SECRET, Google OAuth creds, etc.)
# Broad on purpose: .env.production, .env.development, etc. (without ".local") are not
# covered by a narrower "*.local" pattern and have leaked from other repos before.
.env*
!.env.example

# Raw Google Cloud Console OAuth credential exports (client_secret_<id>.apps.googleusercontent.com.json)
# — found one sitting in the repo root, uncovered by any existing pattern. Never commit this shape.
client_secret_*.json

